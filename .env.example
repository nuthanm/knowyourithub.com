# Public site URL (no trailing slash)
# Local: http://localhost:3000 · Production: https://knowyourithub.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: absolute API host if submit/API runs on a different origin than the site.
# Leave empty on Vercel when UI and API share the same deployment (uses relative /api/*).
NEXT_PUBLIC_SUBMIT_API_URL=

# Comma-separated extra CORS origins for the API (e.g. https://knowyourithub.com)
API_CORS_ORIGINS=

# PostgreSQL (Neon recommended) — optional in dev; required in production unless Upstash is configured
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Gmail / SMTP (App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Know Your IT Hub <noreply@knowyourithub.com>"
MAIL_TO=admin@knowyourithub.com

# Optional: public catalog URL — used for email "Add to queue" redirects
NEXT_PUBLIC_CATALOG_URL=https://knowyourithub.com

# Math CAPTCHA secret — any random string (used for HMAC signing of challenge tokens)
# Production: auto-generated by scripts/setup-vercel-env.ps1
CAPTCHA_SECRET=replace_with_a_random_secret_string

# -----------------------------------------------------------------------------
# Vercel production — run: .\scripts\setup-vercel-env.ps1 -SmtpPass "..."
# Required on Vercel:
#   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_CATALOG_URL, API_CORS_ORIGINS, CAPTCHA_SECRET,
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM, MAIL_TO
# Required on Vercel for durable review queue persistence: configure DATABASE_URL
# or both UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
#   ADMIN_API_KEY
# -----------------------------------------------------------------------------

# Google AdSense — https://www.google.com/adsense/
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Upstash Redis for shared rate limiting on serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin key for reviewing submissions via API (optional)
ADMIN_API_KEY=replace_with_secure_random_key

# Passcode entered on /coming-soon to unlock queue moderation for eight hours.
# Falls back to ADMIN_API_KEY when omitted.
REVIEW_QUEUE_PASSCODE=

# Optional: enforce DB catalog snapshot availability at build time.
# Set to 1 in production to fail build if DB snapshot cannot be pulled.
CATALOG_DB_REQUIRED=0
